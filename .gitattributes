# Evaluation routes are checksummed (workshop 19); keep LF in the working tree.
workshops/17-evaluation/routes/** text eol=lf
# Python launchers and manifests are shared by Linux and Windows.
*.py text eol=lf
*.toml text eol=lf
uv.lock text eol=lf
# Private generalization tests are not part of the student material (git archive).
workshops/**/tests/*_private.py export-ignore
workshops/**/tests/fixtures_private/** export-ignore
workshops/**/tests/fixtures_private export-ignore
