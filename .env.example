# Copy this file to .env. Never commit .env.
# The Azure key stays on the proxy server; it is not needed in simulated mode.

# Mode of the proxy and of the model client: simulated | replay | live
# live is the reference for every workshop; simulated is the default of the CI and of
# check-bootstrap / check-inert.
PROXY_MODE=simulated
MODEL_MODE=simulated

# Azure OpenAI key and endpoint (live mode only, never committed)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_JUDGE_DEPLOYMENT=
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=
AZURE_OPENAI_FALLBACK_DEPLOYMENT=
AZURE_OPENAI_RERANKING_DEPLOYMENT=

# Internal secret used to sign the test tokens (students, observation, identity)
TOKEN_SECRET=change-me-locally
OBSERVATION_TOKEN=workshop-observation

# Default quotas of a student token (live mode)
DAILY_TOKEN_QUOTA=200000
DAILY_REQUEST_QUOTA=500

# Provisional decisions (see docs/decisions.md), to calibrate with the real model
# JUDGE_K / JUDGE_N: a rubric replayed on fresh conversations passes when K runs out of N pass
COMPACTION_MESSAGE_THRESHOLD=8
PROMPT_TOKEN_CAP=800
JUDGE_K=3
JUDGE_N=5
# ROUTE_K / ROUTE_N: same rule for the evaluation routes of workshop 17 (once per route by default)
ROUTE_K=1
ROUTE_N=1
# Meaning layer of the judge: auto (used when configured) | semantic (mandatory) | structural (off)
JUDGE_MODE=auto
# OpenAI-compatible base URL of the judge model and its bearer token (never committed)
JUDGE_BASE_URL=
JUDGE_API_KEY=

# Student-edited files read by the kit (relative paths resolve against the repository root)
MY_AGENT_DIR=my-agent
SANDBOX_POLICY_FILE=my-agent/sandbox/policy.yaml
SKILLS_DIR=my-agent/skills
ATTACHMENTS_DIR=my-agent/attachments
