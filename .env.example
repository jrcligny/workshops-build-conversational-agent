# Copiez ce fichier vers .env. Ne commitez jamais .env.
# La clé Azure reste côté serveur du proxy ; elle n'est pas requise en mode simulé.

# Mode du proxy et du client de modèle : simule | rejoue | reel
PROXY_MODE=simule
MODELE_MODE=simule

# Clé et point de terminaison Azure OpenAI (uniquement en mode réel, jamais versionnés)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOIEMENT_CHAT=
AZURE_OPENAI_DEPLOIEMENT_JUGE=
AZURE_OPENAI_DEPLOIEMENT_EMBEDDINGS=
AZURE_OPENAI_DEPLOIEMENT_REPLI=

# Secret interne pour signer les jetons d'essai (étudiants, observation, identité)
SECRET_JETONS=changez-moi-en-local
JETON_OBSERVATION=essai-pedagogique

# Quotas par défaut d'un jeton étudiant (mode réel)
QUOTA_JETONS_PAR_JOUR=200000
QUOTA_REQUETES_PAR_JOUR=500
